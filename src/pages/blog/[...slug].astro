---
import BlogPost from "../../layouts/BlogPost.astro";
import { getCollection, render } from "astro:content";
import { assertValidPostSlugs, getPostHref, getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  assertValidPostSlugs(posts);

  const paths = posts
    .filter(post => !post.data.draft)
    .map(post => ({
      params: { slug: post.data.slug },
      props: { post },
    }));

  const legacyPaths = posts
    .filter(post => !post.data.draft)
    .flatMap(post => post.data.legacySlugs.map(legacySlug => ({
      params: { slug: legacySlug },
      props: { redirectTo: getPostHref(post) },
    })));

  return [...paths, ...legacyPaths];
}

const { post, redirectTo } = Astro.props;

let Content;
let prev = null;
let next = null;
let readingTime = 1;

if (post) {
  const rendered = await render(post);
  Content = rendered.Content;

  const allPosts = getPublishedPosts(await getCollection("blog"));
  const idx = allPosts.findIndex(p => p.id === post.id);
  prev = idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
  next = idx > 0 ? allPosts[idx - 1] : null;

  const wordCount = post.body ? post.body.length : 0;
  readingTime = Math.max(1, Math.ceil(wordCount / 400));
}
---

{redirectTo ? (
  <html lang="zh-CN">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <meta http-equiv="refresh" content={`0; url=${redirectTo}`} />
      <meta name="robots" content="noindex" />
      <link rel="canonical" href={redirectTo} />
      <title>Redirecting...</title>
    </head>
    <body data-pagefind-ignore>
      <a href={redirectTo}>Redirecting...</a>
    </body>
  </html>
) : (
  <BlogPost post={post} prev={prev} next={next} readingTime={readingTime}>
    <Content />
  </BlogPost>
)}
